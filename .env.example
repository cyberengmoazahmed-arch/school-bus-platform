# SafeRide — environment variables (copy to .env and fill in).
# DATABASE_URL           local: file:./prisma/dev.db | remote (Turso): libsql://<db>.turso.io
# DATABASE_AUTH_TOKEN    Turso database token (required only for remote libSQL/Turso)
# AUTH_SECRET            >=32 random chars. Generate with: openssl rand -base64 32
# AUTH_DEV_OTP           unset ("false") => real OTP via SMS. Set in dev to make the
#                        code visible on /verify-phone so you can log in without SMS.

DATABASE_URL="file:./prisma/dev.db"
DATABASE_AUTH_TOKEN=""
AUTH_SECRET="change-me-please-use-openssl-rand-64"
AUTH_DEV_OTP="true"
AUTH_SESSION_TTL=604800

NEXT_PUBLIC_APP_NAME="SafeRide"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_MAPS_PROVIDER="osm"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Paymob (https://accept.paymob.com). Sandbox credentials from the Paymob dashboard.
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""
PAYMOB_BASE_URL="https://accept.paymob.com/api"
PAYMENTS_MODE="sandbox"

# Notification providers (all optional; empty = logged as failed, app keeps working)
FCM_SERVER_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@saferide.example"
SMS_PROVIDER=""
SMS_API_KEY=""
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Guards the cron job endpoint (/api/jobs/run). Generate a random string.
JOBS_SECRET="dev-jobs-secret-change-me"